NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string (include the database name, e.g. /doctor_tracker)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctor_tracker?retryWrites=true&w=majority
# At least 32 random characters: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Credentials for the admin account created by `pnpm seed`
ADMIN_EMAIL=admin@doctortracker.com
ADMIN_PASSWORD=Admin@123
